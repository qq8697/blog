<aside id="sidebar">
    <!-- Recent Posts -->
    <div class="widget-wrap">
        <h3 class="widget-title">最新文章</h3>
        <div class="widget">
            <ul id="recent-post" class="">
                <% site.posts.sort('date', -1).limit(5).each(function(post) { %>
                    <li>
                        <div class="item-thumbnail">
                            <a href="<%= url_for(post.path) %>" class="thumbnail">
                                <span class="thumbnail-image thumbnail-none"></span>
                            </a>
                        </div>
                        <div class="item-inner">
                            <p class="item-title"><a href="<%= url_for(post.path) %>" class="title"><%= post.title %></a></p>
                            <p class="item-date"><time datetime="<%= post.date.toISOString() %>"><%= date(post.date, 'YYYY-MM-DD') %></time></p>
                        </div>
                    </li>
                <% }) %>
            </ul>
        </div>
    </div>

    <!-- Categories -->
    <div class="widget-wrap">
        <h3 class="widget-title">分类</h3>
        <div class="widget">
            <%- list_categories({ show_count: true, depth: 2 }) %>
        </div>
    </div>

    <!-- Archives -->
    <div class="widget-wrap">
        <h3 class="widget-title">归档</h3>
        <div class="widget">
            <%- list_archives({ type: 'monthly', format: 'MMMM YYYY' }) %>
        </div>
    </div>

    <!-- Tags -->
    <div class="widget-wrap">
        <h3 class="widget-title">标签</h3>
        <div class="widget">
            <%- list_tags({ show_count: true }) %>
        </div>
    </div>

    <!-- Tag Cloud -->
    <div class="widget-wrap">
        <h3 class="widget-title">标签云</h3>
        <div class="widget tagcloud">
            <%- tagcloud({ min_font: 13 }) %>
        </div>
    </div>

    <!-- Links -->
    <% if (theme.links && Object.keys(theme.links).length > 0) { %>
    <div class="widget-wrap widget-list">
        <h3 class="widget-title">链接</h3>
        <div class="widget">
            <ul>
                <% for (var name in theme.links) { %>
                    <li>
                        <a href="<%= theme.links[name] %>"><%= name %></a>
                    </li>
                <% } %>
            </ul>
        </div>
    </div>
    <% } %>

    <div id="toTop" class="fa fa-angle-up"></div>
</aside>
